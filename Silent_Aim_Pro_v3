-- ── helper ──────────────────────────────────────────────
local function part(parent, sx, sy, px, py, color, rx)
    local f = Instance.new("Frame")
    f.Size             = UDim2.new(0, sx, 0, sy)
    f.Position         = UDim2.new(0, px, 0, py)
    f.BackgroundColor3 = color
    f.BorderSizePixel  = 0
    f.Parent           = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = rx or UDim.new(0, 0)
    c.Parent = f
    return f
end

